{
  "name": "simoproof",
  "private": true,
  "version": "1.0.0",
  "description": "SimoProof — Verified Discovery Network. ENS + Gensyn AXL + KeeperHub + ZK proofs.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "demo": "npx tsx scripts/demo.ts",
    "setup": "npx tsx scripts/setup.ts",
    "verify": "npx tsx scripts/verify.ts",
    "axl:start": "node packages/axl/src/standalone.js",
    "api:start": "npx tsx packages/api/src/server.ts",
    "keeperhub:start": "npx tsx packages/keeperhub/src/mcp-server.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "overrides": {
    "axios": "^1.8.2"
  }
}
