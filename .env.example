# ============================================================
# SimoProof — Environment Variables Reference
# Copy to .env and fill in real values.
# ============================================================

# ─── ZK Proof (RISC Zero) ───────────────────────────────────
# "true" = fast dev receipts (no Bonsai needed)
# "false" / unset = production Groth16 via Bonsai
RISC0_DEV_MODE=true

# Bonsai API key — required for production ZK proofs
# Get yours at https://bonsai.xyz
BONSAI_API_KEY=

# ─── Ethereum / Chain ────────────────────────────────────────
# Operator wallet private key (0x + 64 hex chars)
PRIVATE_KEY=

# Sepolia RPC endpoint (for ENS subname writes)
SEPOLIA_RPC=https://rpc.sepolia.org

# Base Sepolia RPC endpoint (for DiscoveryVerifier contract)
BASE_SEPOLIA_RPC=https://sepolia.base.org

# ─── Deployed Contracts ──────────────────────────────────────
# Run `forge script Deploy --rpc-url $BASE_SEPOLIA_RPC --broadcast` to get these
DISCOVERY_VERIFIER_ADDRESS=
DISCOVERY_SCHEMA_UID=

# ─── ENS ─────────────────────────────────────────────────────
# Your node's ENS subname (e.g. node-1.simoproof.eth)
# Must be owned by PRIVATE_KEY on Sepolia
ENS_SUBNAME=

# ─── LLM / OpenAI (Simocracy senate votes) ───────────────────
OPENAI_API_KEY=

# Optional: OpenAI-compatible endpoint (e.g. http://localhost:11434/v1 for Ollama)
LLM_BASE_URL=

# Model for senate deliberation (default: gpt-4o-mini)
LLM_MODEL=gpt-4o-mini

# ─── AT Protocol / Bluesky (Simocracy broadcast) ─────────────
# Bluesky handle (e.g. yourname.bsky.social)
ATPROTO_HANDLE=

# Bluesky app-password (Settings → App passwords)
ATPROTO_PASSWORD=

# Comma-separated DIDs of simocracy senators
# e.g. did:plc:abc123,did:plc:def456
SIM_DIDS=

# ─── AXL P2P Network (Gensyn) ────────────────────────────────
# Path to the compiled AXL binary
AXL_BINARY_PATH=/workspace/axl-node

# Working directory for AXL node persistent data
AXL_WORKING_DIR=/workspace/axl-data

# Stable peer ID for this node (generated on first run; use axl-node --init)
AXL_NODE_ID=simoproof-node-1

# HTTP API port this AXL node listens on
AXL_API_PORT=7001

# URL of node-1 for pipeline bootstrapping
AXL_NODE_1_URL=http://127.0.0.1:7001

# Comma-separated AXL peer IDs for multi-node production setup
# Leave blank for single-node local dev
AXL_PEER_IDS=

# ─── KeeperHub ───────────────────────────────────────────────
KEEPERHUB_API_KEY=
KEEPERHUB_BASE_URL=https://api.keeperhub.com

# ─── API Server ──────────────────────────────────────────────
PORT=3000

# Absolute path to the monorepo root (used by KeeperHub MCP server for tool discovery)
PROJECT_ROOT=/workspace/simoproof

# ─── 0G Decentralised Storage ────────────────────────────────
ZERO_G_RPC_URL=https://evmrpc-testnet.0g.ai
ZERO_G_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai

# Separate 0G upload key — if unset, falls back to PRIVATE_KEY
ZERO_G_PRIVATE_KEY=

# RISC Zero verifier router (Base Sepolia) — from dev.risczero.com/api/blockchain-integration
RISC0_VERIFIER_ADDRESS=

# Guest ELF image ID (bytes32) — run `cargo run -p simoproof-prover -- image-id`
GUEST_IMAGE_ID=
